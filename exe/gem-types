#!/usr/bin/env ruby
# frozen_string_literal: true

# gem-types: gather type evidence for a gem from several tools, draft RBS,
# and verify signatures for ruby/gem_rbs_collection.
#
#   gem-types pick      <gem_rbs_collection dir> [--top 500] [--limit 30] [--min-months N]
#   gem-types prepare   <gem> [version] [workdir]
#   gem-types run       <gem> [gem...] [--base DIR] [--jobs N] [--worktrees <gem_rbs_collection> [--ref REF]]
#                       (prepare..draft for each gem in parallel; worktrees on add-<gem>; workflow args)
#   gem-types collect   --workdir W --ns Foo --test-cmd "..." [--sources a,b] [--jobs N] [--require foo] [--lib lib] [--tests test,spec]
#   gem-types draft     --workdir W [--existing path/to/foo.rbs]
#   gem-types exists    --workdir W --sig path/to/foo.rbs
#   gem-types steep     --workdir W --sig dir_or_file [--library json,uri]
#   gem-types verify    --workdir W --sig path/to/foo.rbs   (exists + steep + test suite with type checks,
#                       uncalled and too-wide declarations, PR text)
#   gem-types live      --workdir W --sig path/to/foo.rbs [--test-cmd CMD]
#                       (which declarations the runtime checks really cover: every return type made `bot`)
#   gem-types pr-text   --workdir W --sig path/to/foo.rbs   (commit message / PR body draft from the RBS,
#                       the source and the saved verify/live results)
#   gem-types lint      --workdir W --sig path/to/foo.rbs [--fix]   (static checks only: blocks, arity,
#                       nil, literals, protocol methods, manifest, test style; seconds. --fix edits the
#                       RBS and manifest.yaml where the fix is mechanical, then lists what is left)
#   gem-types update    --workdir W --sig path/to/foo.rbs [--from OLD_VERSION] [--library json,uri]
#                       (existing RBS vs a new version: source changes, gone/missing methods, steep, tests)
#   gem-types check     [rbs_check.sh options] -- <command>
#   gem-types coverage  <file.rbs> <calls file>
#
# `collect` saves its settings to W/gem-types.json, so `draft` (and a later
# `collect --sources x`) can reuse them.

# Use this tool's own Gemfile even when BUNDLE_GEMFILE points at a gem's
# test environment (as it does around `gem-types check`), and keep the
# caller's environment for the commands we start.
CALLER_ENV = ENV.to_h.freeze
ENV["BUNDLE_GEMFILE"] = File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "optparse"
require "json"
require "yaml"
require_relative "../lib/gem_types"

# The scripts run the gem's own code and environment, so they must not
# inherit this tool's bundle.
def libexec(script, args)
  path = File.join(GemTypes::LIBEXEC, script)
  Bundler.with_unbundled_env do
    ENV.replace(CALLER_ENV)
    exec(*(script.end_with?(".rb") ? [RbConfig.ruby, path] : [path]), *args)
  end
end

def load_config(workdir, opts)
  file = File.join(workdir, "gem-types.json")
  saved = File.exist?(file) ? JSON.parse(File.read(file), symbolize_names: true) : {}
  # repo_dir (from prepare) is the gem's root in a monorepo checkout.
  repo_dir = File.join(workdir, "repo_dir")
  prepared = File.read(repo_dir).strip if File.exist?(repo_dir)
  repo = opts[:repo] || saved[:repo] ||
         [prepared, File.join(workdir, "repo"), File.join(workdir, "pkg")].find { |d| d && !d.empty? && Dir.exist?(d) }
  env = saved[:env] || {}
  if env.empty?
    gemfile = File.join(workdir, "env", "Gemfile")
    gemhome = File.join(workdir, "gemhome")
    env = { BUNDLE_GEMFILE: gemfile, GEM_HOME: gemhome, GEM_PATH: gemhome } if File.exist?(gemfile)
  end
  ns = opts[:ns] || saved[:ns] or abort "--ns is required"
  cfg = GemTypes::Config.new(
    repo: File.expand_path(repo || abort("no repo: pass --repo or run prepare")),
    lib_dirs: opts[:lib] || saved[:lib_dirs] || ["lib"],
    test_dirs: opts[:tests] || saved[:test_dirs] || %w[test spec],
    ns: ns,
    requires: opts[:requires] || saved[:requires] || [ns.first.gsub("::", "/").gsub(/([a-z\d])([A-Z])/, '\1_\2').downcase],
    test_cmd: opts[:test_cmd] || saved[:test_cmd] ||
              (File.read(File.join(workdir, "test_cmd")).strip if File.exist?(File.join(workdir, "test_cmd"))),
    env: env.transform_keys(&:to_s),
    out: File.join(File.expand_path(workdir), "evidence")
  )
  File.write(file, JSON.pretty_generate(cfg.to_h.except(:out)))
  cfg
end

def parse(args)
  opts = {}
  OptionParser.new do |o|
    o.on("--workdir DIR") { opts[:workdir] = _1 }
    o.on("--repo DIR") { opts[:repo] = _1 }
    o.on("--ns LIST", Array) { opts[:ns] = _1 }
    o.on("--require LIST", Array) { opts[:requires] = _1 }
    o.on("--test-cmd CMD") { opts[:test_cmd] = _1 }
    o.on("--sources LIST", Array) { opts[:sources] = _1 }
    o.on("--lib LIST", Array) { opts[:lib] = _1 }
    o.on("--tests LIST", Array) { opts[:tests] = _1 }
    o.on("--existing FILE") { opts[:existing] = _1 }
    o.on("--jobs N", Integer) { opts[:jobs] = _1 }
    o.on("--sig PATH") { opts[:sig] = _1 }
    o.on("--library LIST", Array) { opts[:library] = _1 }
    o.on("--from VERSION") { opts[:from] = _1 }
  end.parse!(args)
  opts[:workdir] or abort "--workdir is required"
  opts
end

cmd = ARGV.shift
case cmd
when "pick" then libexec("pick_gems.rb", ARGV)
when "prepare" then libexec("prepare_gem.sh", ARGV)
when "check" then libexec("rbs_check.sh", ARGV)
when "coverage" then libexec("coverage_report.rb", ARGV)
when "run"
  base = "rbs-work"
  jobs = 2
  worktrees = nil
  ref = "HEAD"
  OptionParser.new do |o|
    o.on("--base DIR") { base = _1 }
    o.on("--jobs N", Integer) { jobs = _1 }
    o.on("--worktrees REPO") { worktrees = _1 }
    o.on("--ref REF") { ref = _1 }
  end.parse!(ARGV)
  abort "usage: gem-types run <gem> [gem...] [--base DIR] [--jobs N] [--worktrees <gem_rbs_collection>] [--ref REF]" if ARGV.empty?
  batch = GemTypes::Batch.new(ARGV.dup, base: base, jobs: jobs, worktrees: worktrees, ref: ref)
  results = batch.run
  table = batch.summary(results)
  File.write(File.join(File.expand_path(base), "run-summary.md"), table + "\n")
  args_file = File.join(File.expand_path(base), "workflow-args.json")
  File.write(args_file, JSON.pretty_generate(batch.workflow_args(results)))
  puts table
  puts "", "Arguments for the gem-rbs-author workflow: #{args_file}"
  exit(results.all? { _1.status == "ok" } ? 0 : 1)
when "collect"
  opts = parse(ARGV)
  unknown = (opts[:sources] || []) - GemTypes::Sources::ALL
  abort "unknown source(s): #{unknown.join(', ')} (known: #{GemTypes::Sources::ALL.join(', ')})" unless unknown.empty?
  cfg = load_config(opts[:workdir], opts)
  selected = opts[:sources] || GemTypes::Sources::ALL
  run_one = lambda do |src|
    t = Time.now
    ok = GemTypes::Sources.for(src, cfg).run
    warn format("  %-10s %-6s %5.1fs", src, ok == false || ok.nil? ? "failed" : "ok", Time.now - t)
  end
  # Static sources do not touch the test environment: run them in parallel
  # with the test runs. Test runs share the repo (files, ports), so they run
  # one at a time unless --jobs says otherwise.
  static = selected & GemTypes::Sources::STATIC
  runtime = selected & GemTypes::Sources::RUNTIME
  threads = static.map { |src| Thread.new { run_one.(src) } }
  runtime.each_slice([opts[:jobs] || 1, 1].max) do |batch|
    batch.map { |src| Thread.new { run_one.(src) } }.each(&:join)
  end
  threads.each(&:join)
when "draft"
  opts = parse(ARGV)
  cfg = load_config(opts[:workdir], opts)
  evidence = {}
  classes = {}
  shapes = []
  GemTypes::Sources::ALL.each do |src|
    s = GemTypes::Sources.for(src, cfg)
    h = s.read
    evidence[src] = h unless h.empty?
    classes = s.classes.merge(classes) if s.respond_to?(:classes)
    shapes = s.shapes if src == "tracepoint"
  end
  # --existing takes a file or a directory (without its _test/ files).
  existing_rbs = opts[:existing] && GemTypes::RbsReader.read_files(GemTypes::RbsReader.sig_files(File.expand_path(opts[:existing])))
  existing = existing_rbs ? existing_rbs.methods : {}
  classes = GemTypes::Merger.with_existing_classes(classes, existing_rbs.classes) if existing_rbs
  merger = GemTypes::Merger.new(evidence: evidence, classes: classes, shapes: shapes, existing: existing,
                                defs: GemTypes::DefIndex.new(cfg.lib_paths))
  File.write(File.join(opts[:workdir], "draft.rbs"), merger.draft)
  File.write(File.join(opts[:workdir], "report.md"), merger.report)
  warn "wrote #{File.join(opts[:workdir], 'draft.rbs')} and report.md"
  begin
    RBS::Parser.parse_signature(File.read(File.join(opts[:workdir], "draft.rbs")))
  rescue RBS::ParsingError => e
    warn "draft.rbs does not parse: #{e.message.lines.first}"
  end
  evidence.each { |src, h| warn "  #{src}: #{h.size} methods" }
when "exists"
  opts = parse(ARGV)
  cfg = load_config(opts[:workdir], opts)
  sig = File.expand_path(opts[:sig] || abort("--sig is required"))
  exit GemTypes::Verify.exists(cfg, sig)
when "verify"
  opts = parse(ARGV)
  cfg = load_config(opts[:workdir], opts)
  sig = File.expand_path(opts[:sig] || abort("--sig is required"))
  sigdir = File.directory?(sig) ? sig : File.dirname(sig)
  libs = opts[:library] || begin
    m = File.join(sigdir, "manifest.yaml")
    File.exist?(m) ? (YAML.load_file(m)["dependencies"] || []).map { _1["name"] } : []
  end
  # RBS that does not parse would pass every later check (each reads it as
  # empty): stop here.
  begin
    rbs_files = GemTypes::Verify.parse_sigs(sig).map(&:first)
  rescue GemTypes::Verify::SigError => e
    exit GemTypes::Verify.sig_error(e)
  end
  puts "== exists"
  exists = GemTypes::Verify.exists(cfg, sig)
  puts "", "== steep"
  steep = GemTypes::Verify.steep(cfg, sig, libs)
  puts "", "== test suite (plain, then with runtime type checking)"
  r = GemTypes::Verify.suite(cfg, sig)
  p_, c = r[:plain], r[:checked]
  incomplete = r[:incomplete]
  puts "plain:   #{p_[:total]} #{p_[:unit]}, #{p_[:failed]} failing#{p_[:outside].to_i.positive? ? " (#{p_[:outside]} errors outside of examples)" : ''}"
  puts "checked: #{c[:total]} #{c[:unit]}, #{c[:failed]} failing, #{r[:checks]} type checks, #{r[:errors].size} distinct type errors" \
       "#{c[:outside].to_i.positive? ? " (#{c[:outside]} errors outside of examples)" : ''}"
  unless incomplete.empty?
    puts "CHECKED RUN INCOMPLETE: #{incomplete.join('; ')}."
    puts "  The runtime checks did not cover the suite: fix the run (see #{r[:logs].last}) before trusting these numbers."
  end
  r[:errors].first(20).each { |e| puts "  #{e[0, 220]}" }
  puts "  errors: #{r[:errors_file]}" unless r[:errors].empty?
  if r[:uncalled] && !incomplete.empty?
    puts "", "== declared methods the test suite never called", "  (not listed: the checked run is incomplete)"
  elsif r[:uncalled]
    puts "", "== declared methods the test suite never called (#{r[:uncalled].size})"
    puts "  (call these from your verification script)" unless r[:uncalled].empty?
    r[:uncalled].each { |k| puts "  #{k}" }
    unless r[:uncalled_private].to_a.empty?
      puts "  private, never called (#{r[:uncalled_private].size}; call them with send or through the public API):"
      r[:uncalled_private].each { |k| puts "    #{k}" }
    end
  end
  puts "", "== lint (mistakes the source shows directly)"
  lint = GemTypes::Verify.lint(cfg, sig)
  inv = GemTypes::Verify.invariant_params(cfg, sig)
  lint += inv.map { |key, slot, msg| [key, "#{slot}: #{msg}"] }
  puts "  nothing" if lint.empty?
  lint.each { |key, msg| puts "  #{key}: #{msg}" }
  puts "", "== possibly too wide (declared, never seen in the test suite)"
  wide = GemTypes::Verify.too_wide(cfg, sig)
  if wide.nil?
    puts "  (no tracepoint evidence: run `gem-types collect --sources tracepoint` first)"
  elsif wide.empty?
    puts "  nothing"
  else
    puts "  Tests rarely pass every accepted type; check each against the source."
    wide.each { |key, slot, msg| puts "  #{key} #{slot}: #{msg}" }
  end
  declared = rbs_files.sum { |f| GemTypes::RbsReader.read_files([f], include_private: true).methods.size }
  # An incomplete run is recorded as an error too, so readers of
  # verify.json that only look at "errors" never print "no type errors".
  json_errors = incomplete.empty? ? r[:errors] : ["CHECKED RUN INCOMPLETE: #{incomplete.join('; ')}"] + r[:errors]
  File.write(File.join(cfg.out, "verify.json"), JSON.pretty_generate(
    exists: exists.zero?, steep: steep.zero?, plain: p_, checked: c, checks: r[:checks],
    suite_complete: incomplete.empty?, incomplete: incomplete, plain_ok: r[:plain_ok], checked_ok: r[:checked_ok],
    errors: json_errors, uncalled: r[:uncalled], uncalled_private: r[:uncalled_private], too_wide: wide, lint: lint
  ))
  puts "", "== Verification section for the PR (edit the last line to explain any remaining type errors)", ""
  puts "## Verification", ""
  puts "- `bin/test` and RuboCop pass."
  puts "- Reviewed the signatures against the gem source; every declared method, class and module exists in the loaded gem." if exists.zero?
  puts "- Called every declared method with runtime type checking (`rbs/test/setup`)."
  if incomplete.empty?
    tail = r[:errors].empty? ? "no type errors" : "#{r[:errors].size} distinct type errors (explain)"
    puts "- Ran the gem's own test suite with runtime type checking: #{c[:total]} #{c[:unit]}, #{r[:checks]} type checks, #{tail}."
  else
    puts "- CHECKED RUN INCOMPLETE (#{incomplete.join('; ')}): do not claim a test suite result until it completes."
  end
  puts "", "(#{declared} declarations; run your call-every-method script with `gem-types check -c` and `gem-types coverage` before keeping the third line)"
  problems = []
  problems << "exists" unless exists.zero?
  problems << "steep" unless steep.zero?
  problems << "checked run incomplete" unless incomplete.empty?
  problems << "type errors" unless r[:errors].empty?
  puts "", "VERIFY FAILED: #{problems.join(', ')}" unless problems.empty?
  exit(problems.empty? ? 0 : 1)
when "live"
  opts = parse(ARGV)
  # --test-cmd here is the command to check (often a call-every-method
  # script), not the gem's test suite: do not save it in gem-types.json.
  cfg = load_config(opts[:workdir], opts.except(:test_cmd))
  sig = File.expand_path(opts[:sig] || abort("--sig is required"))
  cmd = opts[:test_cmd] || cfg.test_cmd or abort "no test command"
  begin
    r = GemTypes::Verify.live(cfg, sig, cmd)
  rescue GemTypes::Verify::SigError => e
    exit GemTypes::Verify.sig_error(e)
  end
  total = r[:checked].size + r[:unchecked].size
  File.write(File.join(cfg.out, "live.json"), JSON.pretty_generate(r.merge(cmd: cmd)))
  puts "#{r[:checked].size}/#{total} declarations failed as expected with every return type made bot (really checked at runtime)."
  unless r[:unchecked].empty?
    puts "Not checked by this command (never called, inherited rather than defined, or not hookable):"
    r[:unchecked].each { |k| puts "  #{k}#{r[:private].include?(k) ? ' (private)' : ''}" }
    puts "Call them from a script and rerun with --test-cmd, or check them with assertions."
  end
  puts "(not mutated: initialize #{r[:skipped].size}; log: #{r[:log]})"
  unless r[:aliases].empty?
    puts "Aliases not mutated themselves and not seen failing (#{r[:aliases].size}; covered only through the aliased method): #{r[:aliases].join(', ')}"
  end
  exit(r[:unchecked].empty? ? 0 : 1)
when "lint"
  # The static checks alone (seconds, nothing runs): use it while writing.
  # --fix applies the mechanical fixes to the RBS files and manifest.yaml.
  fix = !ARGV.delete("--fix").nil?
  opts = parse(ARGV)
  cfg = load_config(opts[:workdir], opts)
  sig = File.expand_path(opts[:sig] || abort("--sig is required"))
  begin
    GemTypes::Verify.parse_sigs(sig)
  rescue GemTypes::Verify::SigError => e
    exit GemTypes::Verify.sig_error(e)
  end
  lint = GemTypes::Verify.lint(cfg, sig)
  if fix
    res = GemTypes::Lint.apply_fixes(lint)
    puts "== fixed (#{res[:applied].size})"
    res[:applied].each do |f, edits|
      puts "#{f.key}: #{f.message}"
      edits.each { |e| puts "    #{e}" }
    end
    res[:failed].each { |f, why| puts "not fixed: #{f.key}: #{why}" }
    # What is left, from the files as they are now.
    lint = GemTypes::Verify.lint(cfg, sig)
    puts "", "== still needs a human (#{lint.size})"
  end
  puts "nothing" if lint.empty?
  lint.each { |key, msg| puts "#{key}: #{msg}" }
  text = GemTypes::RbsReader.sig_files(sig).map { |f| File.read(f, encoding: "UTF-8") }.join("\n")
  d = GemTypes::Lint.untyped_density(text)
  puts "", "untyped: #{(d * 100).round}% of declarations#{d > 0.35 ? ' (above the recently added gems\' p75 of 35%: type what the source shows)' : ''}"
  exit(lint.empty? ? 0 : 1)
when "pr-text"
  opts = parse(ARGV)
  cfg = load_config(opts[:workdir], opts)
  sig = File.expand_path(opts[:sig] || abort("--sig is required"))
  text = GemTypes::PrText.build(cfg, opts[:workdir], sig)
  out = File.join(opts[:workdir], "commit-message.txt")
  File.write(out, text)
  puts text, "", "(written to #{out}; edit the bullets, then `git commit -F` it)"
when "update"
  opts = parse(ARGV)
  cfg = load_config(opts[:workdir], opts)
  sig = File.expand_path(opts[:sig] || abort("--sig is required"))
  sigdir = File.directory?(sig) ? sig : File.dirname(sig)
  libs = opts[:library] || begin
    m = File.join(sigdir, "manifest.yaml")
    File.exist?(m) ? (YAML.load_file(m)["dependencies"] || []).map { _1["name"] } : []
  end
  exit GemTypes::Update.run(cfg, opts[:workdir], sig, from: opts[:from], libraries: libs)
when "steep"
  opts = parse(ARGV)
  cfg = load_config(opts[:workdir], opts)
  sig = File.expand_path(opts[:sig] || abort("--sig is required"))
  exit GemTypes::Verify.steep(cfg, sig, opts[:library] || [])
else
  usage = File.read(__FILE__).lines.drop_while { !_1.start_with?("#   gem-types") }
              .take_while { _1.start_with?("#") }.map { _1.sub(/^# ?/, "") }.join
  warn usage
  exit(cmd.nil? || %w[-h --help help].include?(cmd) ? 0 : 1)
end
