class Tag < BasicObject
  def initialize: () -> void
  def tag!: (Symbol name) ?{ (Tag) -> void } -> String
  def out: () -> String
end
class Disp
  def run: () { (Integer, ?Integer) -> untyped } -> untyped
  def lam?: () { (*untyped) -> untyped } -> bool
  def keep: () { () -> untyped } -> Proc
  def kept: () -> Proc?
end
class Pre
  def name=: (String v) -> String
  def name: () -> String?
  def wrapped: () -> bool?
end
