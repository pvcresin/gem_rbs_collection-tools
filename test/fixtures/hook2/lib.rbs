module Reg
  class Types
    def self.pub: () -> bot
    def self.lazy?: () -> bot
    def self.call_secret: () -> Integer
    private def self.secret: () -> bot
  end
end
class Cache
  def self.load: () -> bot
  attr_accessor version: bot
end
class Gen
  def size: () -> bot
end
class Reopen
  def initialize: (String x) -> void
  def get: () -> bot
end
